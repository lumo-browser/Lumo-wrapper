{
  "appId": "com.lumobrowser.app",
  "productName": "Lumo Browser",
  "directories": {
    "buildResources": "assets",
    "output": "out"
  },
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "assets/logo.png"
  ],
  "win": {
    "icon": "assets/logo.png",
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "icon": "assets/logo.png",
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.utilities"
  },
  "linux": {
    "icon": "assets/icons",
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "maintainer": "Sai <sai@example.com>"
  }
}
